#!/bin/sh
#
# Watch an agent run a permission hook, and keep what it hands the hook, before
# Crook answers one. What was measured with it is docs/answering.md.
#
#   ./script/probe-permission-hooks claude                  # make the throwaway project, print how to start
#   ./script/probe-permission-hooks claude variant HOLD=60  # what the next permission hook does
#   ./script/probe-permission-hooks claude timeline         # every hook and signal so far, in order
#   ./script/probe-permission-hooks claude --clean          # remove that project, its recorder and processes
#   ./script/probe-permission-hooks --clean                 # remove every probe project
#
# The agents are claude, codex, opencode and copilot. Each gets a project of
# its own, $XDG_RUNTIME_DIR/crook-probe-<agent> ($TMPDIR on macOS, which has no
# XDG_RUNTIME_DIR), never /tmp: the /tmp tmpfs on the machine this was written
# on carries a per-user quota that cargo builds fill, and a full quota breaks
# Crook's shell integration in every pane. The hooks are registered in that
# project alone: its .claude/settings.json, .github/hooks/probe.json or
# .opencode/plugins/record.ts, or for Codex the hooks.json of a CODEX_HOME
# inside it, .probe/codex-home, where trusting them is kept too. Nothing here
# edits ~/.claude/settings.json, ~/.codex, ~/.copilot or the installed Crook
# plugin.
#
# The recorder is one POSIX sh file, run by every hook of the agent's. Each run
# appends to $PROBE_DIR/<epoch>-<pid>-<event>.*:
#
#   .json  its stdin, the payload the agent handed it
#   .env   its environment, the CLAUDE*, CODEX_*, COPILOT_*, GEMINI_*, TERM*,
#          TMUX* and CROOK_* names only, with anything named like a token,
#          key, secret or password blanked
#   .ps    pid, ppid, pgid, sid, tty and comm for itself and every ancestor,
#          /proc/<pid>/stat's tty_nr on Linux, and whether /dev/tty opens
#   .sig   every TERM, HUP, INT and PIPE it receives, what it printed, and
#          when it exited; and, from a watcher that no signal to the hook's
#          process group or tree reaches, when it was gone and whether its
#          exit trap ran first, which is how a SIGKILL no trap sees shows up
#
# PROBE_DIR is $root/evidence unless it is set when the project is made, and
# --clean removes it with the project; set it elsewhere to keep the evidence.
#
# A permission hook (Claude Code's and Codex's PermissionRequest, Copilot's
# permissionRequest or PermissionRequest, whichever fires) then does what the
# variant says. The variant comes from the environment the agent was started
# with, and the `variant` command's file overrides it, so one session can run
# every case without a restart:
#
#   PROBE_HOLD=<s>      hold that long before answering (0)
#   PROBE_DECISION=x    then print allow, deny or none (none) in the agent's
#                       own shape: hookSpecificOutput.decision.behavior for
#                       Claude Code and Codex, {"behavior":...} for Copilot
#   PROBE_AFTER=<s>     leave two background children, their output on
#                       /dev/null, alive that long after the answer (0, none):
#                       one in the hook's process group and one in a session
#                       of its own, to see whether the agent signals the group,
#                       the hook's whole tree, or neither, waits for them, or
#                       orphans them
#   PROBE_TRAP=x        exit on a signal the way an untrapped hook would, or
#                       stay and keep holding, to see what follows a TERM
#                       (exit)
#   PROBE_MESSAGE=text  the deny's message
#
# At setup, PROBE_TIMEOUT=<s> gives the permission hook a timeout of its own
# (Claude Code's and Codex's `timeout`, Copilot's `timeoutSec`), and
# PROBE_SECOND=1 registers a second permission hook beside the first.
#
# OpenCode has no command hooks, so its recorder is a plugin: it writes each
# permission.* and question.* event the same way, and with PROBE_DECISION
# replies after PROBE_HOLD through the client a plugin is handed.
#
# Every probe of a live agent spends its usage. Start it with the cheapest
# model, give it short prompts, and run --clean when done: no recorder may be
# left where an agent would run it.

set -eu

fail() {
  echo "probe-permission-hooks: $*" >&2
  exit 1
}

usage() {
  fail "usage: script/probe-permission-hooks <claude|codex|opencode|copilot> [variant K=V ... | timeline | --clean] | --clean"
}

# The project's directory goes into JSON strings and shell words unquoted by
# anything but single quotes, so it is held to characters that need neither.
plain_path() {
  case $1 in
    /*) ;;
    *) fail "$2 must be an absolute path: $1" ;;
  esac
  case $1 in
    *[!A-Za-z0-9/._-]*) fail "$2 must be letters, digits and / . _ - only: $1" ;;
  esac
}

runtime=${XDG_RUNTIME_DIR:-${TMPDIR:-}}
runtime=${runtime%/}
[ -n "$runtime" ] || fail "neither XDG_RUNTIME_DIR nor TMPDIR is set; there is nowhere off /tmp to put the project"
case $runtime in
  /tmp | /tmp/*) fail "the project would land under /tmp ($runtime), whose quota cargo fills; set XDG_RUNTIME_DIR" ;;
esac

clean() {
  dir=$1
  [ -f "$dir/.probe/agent" ] || fail "$dir was not made by this script; leaving it alone"
  # A held recorder, its background children and its watcher, still running
  # after the agent went: each was started from this project's recorder. A
  # TERM first, which a recorder that exits on one logs; then a KILL for
  # whatever stayed, as a TRAP=stay recorder and every watcher do.
  if pkill -f "$dir/.probe/record" 2>/dev/null; then
    sleep 1
    pkill -KILL -f "$dir/.probe/record" 2>/dev/null || true
  fi
  evidence=$(cat "$dir/.probe/evidence")
  uid=$(id -u)
  # Claude Code 2.1.280's temp directory is CLAUDE_CODE_TMPDIR, or else Bun's
  # os.tmpdir(): $TMPDIR, $TMP or $TEMP, or /tmp when none is set, which on
  # macOS makes it the per-user $TMPDIR under /var/folders. The session's
  # environment need not have been this one, so the temp directory its
  # scratchpad_dir, <temp>/claude-<uid>/<project>/<session>/scratchpad, names
  # is tried as well.
  temps="${CLAUDE_CODE_TMPDIR:-}
${TMPDIR:-}
${TMP:-}
${TEMP:-}
/tmp"
  # Claude Code keeps more for each session than its conversation, under the
  # session's id, which only the SessionStart payloads still name. They name
  # the directory the session saw, too, which on macOS is $TMPDIR's real
  # path under /private rather than the one this script was handed.
  seen=$dir
  for start in "$evidence"/*-SessionStart.json; do
    [ -f "$start" ] || continue
    cwd=$(sed -nE 's/.*"cwd": *"([^"\\]*)".*/\1/p' "$start" | head -n 1)
    case $cwd in
      */crook-probe-*) seen="$seen
$cwd" ;;
    esac
    temp=$(sed -nE 's/.*"scratchpad_dir": *"([^"\\]*)\/claude-'"$uid"'\/[^"\\/]*\/[0-9a-f-]{36}\/scratchpad".*/\1/p' "$start" | head -n 1)
    [ -z "$temp" ] || temps="$temps
$temp"
    id=$(sed -nE 's/.*"session_id": *"([0-9a-f-]{36})".*/\1/p' "$start" | head -n 1)
    [ -n "$id" ] || continue
    for kept in "$HOME/.claude/session-env/$id" "$HOME/.claude/file-history/$id"; do
      [ ! -d "$kept" ] || { rm -rf "$kept" && echo "removed $kept"; }
    done
  done
  rm -rf "$dir"
  echo "removed $dir"
  case $evidence in
    "$dir"/*) ;;
    *) echo "kept the evidence in $evidence" ;;
  esac
  # Claude Code keeps each project's conversations under ~/.claude/projects,
  # and its sessions' scratchpads and task output under claude-<uid> in its
  # temp directory, in a directory named for the path with every character
  # but a letter or a digit made a -, as 2.1.280's replace(/[^a-zA-Z0-9]/g,"-")
  # names it. This project's are the probe's prompts and nothing else, and no
  # other project's has its name, so it is looked for in every temp directory
  # the session might have used.
  temps=$(printf '%s\n' "$temps" | grep . | sed 's:/*$::' | sort -u)
  printf '%s\n' "$seen" | sort -u | while IFS= read -r path; do
    mangled=$(printf '%s\n' "$path" | sed 's/[^A-Za-z0-9]/-/g')
    {
      printf '%s\n' "$HOME/.claude/projects/$mangled"
      printf '%s\n' "$temps" | sed "s:\$:/claude-$uid/$mangled:"
    } | while IFS= read -r kept; do
      [ ! -d "$kept" ] || { rm -rf "$kept" && echo "removed $kept"; }
    done
  done
}

if [ "${1:-}" = --clean ]; then
  [ $# -eq 1 ] || usage
  found=
  for dir in "$runtime"/crook-probe-*; do
    [ -f "$dir/.probe/agent" ] || continue
    clean "$dir"
    found=yes
  done
  [ -n "$found" ] || echo "no probe project under $runtime"
  exit 0
fi

[ $# -ge 1 ] || usage
agent=$1
shift
case $agent in
  claude | codex | opencode | copilot) ;;
  *) usage ;;
esac
root=$runtime/crook-probe-$agent
plain_path "$root" "the project"

case ${1:-} in
  --clean)
    [ $# -eq 1 ] || usage
    clean "$root"
    exit 0
    ;;
  variant)
    shift
    [ -f "$root/.probe/agent" ] || fail "no project at $root; run script/probe-permission-hooks $agent first"
    # Every pair is checked before the variant changes, and the new one takes
    # the old one's place in one rename, so a refused variant leaves the last
    # one as it was and a hook never reads half of one.
    next=$root/.probe/variant.next
    trap 'rm -f "$next"' EXIT
    : >"$next"
    for pair in "$@"; do
      key=${pair%%=*}
      value=${pair#*=}
      case $key in
        HOLD | AFTER)
          case $value in '' | *[!0-9]*) fail "$key takes whole seconds, not $value" ;; esac ;;
        DECISION)
          case $value in allow | deny | none) ;; *) fail "DECISION is allow, deny or none, not $value" ;; esac ;;
        TRAP)
          case $value in exit | stay) ;; *) fail "TRAP is exit or stay, not $value" ;; esac ;;
        MESSAGE) ;;
        *) fail "a variant sets HOLD, AFTER, DECISION, TRAP or MESSAGE, not $key" ;;
      esac
      printf 'PROBE_%s=%s\n' "$key" "$value" >>"$next"
    done
    mv -f "$next" "$root/.probe/variant"
    echo "next permission hook: ${*:-as the environment says}"
    exit 0
    ;;
  timeline)
    [ $# -eq 1 ] || usage
    [ -f "$root/.probe/agent" ] || fail "no project at $root"
    evidence=$(cat "$root/.probe/evidence")
    # One line a hook run, from its payload, and every line the recorders and
    # watchers logged, in time order and in seconds since the first.
    {
      for file in "$evidence"/*.json; do
        [ -f "$file" ] || continue
        name=${file##*/}
        stamp=${name%%-*}
        tool=$(sed -nE 's/.*"tool_name": *"([^"]*)".*/\1/p' "$file" | head -n 1)
        command=$(sed -nE 's/.*"command": *"(([^"\\]|\\.)*)".*/\1/p' "$file" | head -n 1 | cut -c 1-60)
        agent_id=$(sed -nE 's/.*"agent_id": *"([^"]*)".*/ agent_id=\1/p' "$file" | head -n 1)
        printf '%s hook %s %s%s %s\n' "$stamp" "${name#*-}" "${tool:--}" "$agent_id" "$command"
      done
      cat "$evidence"/*.sig 2>/dev/null || true
    } | sort -n | awk 'NR == 1 { first = $1 } { $1 = sprintf("+%8.3f", $1 - first); print }'
    exit 0
    ;;
  '') ;;
  *) usage ;;
esac

[ ! -e "$root" ] || fail "$root exists; run script/probe-permission-hooks $agent --clean first"
evidence=${PROBE_DIR:-$root/evidence}
plain_path "$evidence" PROBE_DIR
timeout=${PROBE_TIMEOUT:-}
case $timeout in *[!0-9]*) fail "PROBE_TIMEOUT takes whole seconds, not $timeout" ;; esac
second=${PROBE_SECOND:-}

mkdir -p "$root/.probe" "$evidence"
printf '%s\n' "$agent" >"$root/.probe/agent"
printf '%s\n' "$evidence" >"$root/.probe/evidence"
record=$root/.probe/record

# The recorder. Its paths are spliced in on the first lines; the rest is
# quoted, so nothing in it is expanded until a hook runs it.
{
  echo '#!/bin/sh'
  echo "# Installed by crook's script/probe-permission-hooks; removed by its --clean."
  echo "root='$root'"
  echo "probe_dir=\${PROBE_DIR:-'$evidence'}"
  cat <<'RECORDER'
self=$0

now() {
  t=$(date +%s.%N 2>/dev/null)
  case $t in *N* | '') t=$(date +%s) ;; esac
  printf '%s\n' "$t"
}

# Whole seconds, so `date +%s` on macOS can say when they are up. A sleep of
# one at a time inside `wait`, because a trapped signal interrupts `wait` and
# not a foreground sleep, and so no sleep outlives this by more than a second.
hold_until() {
  while [ "$(date +%s)" -lt "$1" ]; do
    sleep 1 &
    wait $! || true
  done
}

# The watcher: in a session of its own and nobody's descendant, so that
# neither a signal to the hook's process group nor one to its whole tree
# reaches it, it says when each process it watches is gone and whether that
# process's exit trap ran first. No trap runs on a SIGKILL. A signal that
# reaches it anyway is noted, and it watches on.
if [ "${1:-}" = --watch ]; then
  sig=$2
  end=$(($(date +%s) + $3))
  shift 3
  noted() { printf '%s %s watcher=%s\n' "$(now)" "$1" "$$" >>"$sig"; }
  trap 'noted TERM' TERM
  trap 'noted HUP' HUP
  trap 'noted INT' INT
  pending=$*
  while [ -n "$pending" ] && [ "$(date +%s)" -lt "$end" ]; do
    still=
    for entry in $pending; do
      if kill -0 "${entry#*=}" 2>/dev/null; then
        still="$still $entry"
      elif grep -q " exit $entry\$" "$sig" 2>/dev/null; then
        printf '%s gone %s after-its-exit-trap\n' "$(now)" "$entry" >>"$sig"
      else
        printf '%s gone %s without-its-exit-trap(SIGKILL)\n' "$(now)" "$entry" >>"$sig"
      fi
    done
    pending=$still
    sleep 0.2 2>/dev/null || sleep 1
  done
  for entry in $pending; do
    printf '%s watcher-gave-up %s still-alive\n' "$(now)" "$entry" >>"$sig"
  done
  exit 0
fi

# A background child of a held recorder, alive until the deadline it is
# handed unless something ends it sooner: the `child`, in the hook's process
# group, and the `outsider`, in a session of its own, which only a signal to
# the hook's whole tree of descendants reaches.
if [ "${1:-}" = --child ]; then
  sig=$2
  deadline=$3
  role=$4
  log() { printf '%s %s %s=%s\n' "$(now)" "$1" "$role" "$$" >>"$sig"; }
  trap 'log TERM; exit 143' TERM
  trap 'log HUP; exit 129' HUP
  trap 'log INT; exit 130' INT
  trap 'log exit' EXIT
  log start
  hold_until "$deadline"
  exit 0
fi

agent=${1:-unknown}
event=${2:-unknown}
start=$(now)
mkdir -p "$probe_dir"
base=$probe_dir/$start-$$-$event
sig=$base.sig
log() { printf '%s %s recorder=%s\n' "$(now)" "$1" "$$" >>"$sig"; }

hold=${PROBE_HOLD:-0}
after=${PROBE_AFTER:-0}
decision=${PROBE_DECISION:-none}
trapmode=${PROBE_TRAP:-exit}
message=${PROBE_MESSAGE:-Denied by the probe.}
if [ -f "$root/.probe/variant" ]; then
  while IFS='=' read -r key value; do
    case $key in
      PROBE_HOLD) hold=$value ;;
      PROBE_AFTER) after=$value ;;
      PROBE_DECISION) decision=$value ;;
      PROBE_TRAP) trapmode=$value ;;
      PROBE_MESSAGE) message=$value ;;
    esac
  done <"$root/.probe/variant"
fi
case $hold in '' | *[!0-9]*) hold=0 ;; esac
case $after in '' | *[!0-9]*) after=0 ;; esac
message=$(printf '%s' "$message" | tr -d '"\\')

on_signal() {
  log "$1"
  [ "$trapmode" = stay ] || exit "$2"
}
trap 'on_signal TERM 143' TERM
trap 'on_signal HUP 129' HUP
trap 'on_signal INT 130' INT
trap 'on_signal PIPE 141' PIPE
trap 'log exit' EXIT

log "start agent=$agent event=$event"
cat >"$base.json"
log stdin-closed

env | grep -E '^(CLAUDE|CODEX_|COPILOT_|GEMINI_|TERM|TMUX|CROOK_)' |
  sed -E 's/^([A-Za-z0-9_]*(TOKEN|KEY|SECRET|PASSWORD)[A-Za-z0-9_]*)=.*/\1=<blanked>/' >"$base.env" || true

{
  echo "PID PPID PGID SID TT COMMAND"
  pid=$$
  while [ -n "$pid" ] && [ "$pid" -gt 0 ]; do
    ps -o pid=,ppid=,pgid=,sid=,tty=,comm= -p "$pid" 2>/dev/null ||
      ps -o pid=,ppid=,pgid=,sess=,tty=,comm= -p "$pid" 2>/dev/null || break
    [ "$pid" -gt 1 ] || break
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
  if [ -r "/proc/$$/stat" ]; then
    # The fields after the parenthesised name: state, ppid, pgrp, session, tty_nr.
    echo "tty_nr=$(sed 's/.*) //' "/proc/$$/stat" | cut -d ' ' -f 5)"
  fi
  if (: </dev/tty) 2>/dev/null; then echo "/dev/tty opens"; else echo "/dev/tty does not open"; fi
} >"$base.ps" 2>&1

case $event in
  PermissionRequest* | permissionRequest*) ;;
  *) exit 0 ;;
esac

# The recorder again, in a session of its own: setsid(1) on Linux, Perl's
# setsid on macOS, which has no setsid(1). Only ever run behind `&`, where it
# replaces the subshell, so that $! is the recorder's own pid.
in_own_session() {
  if command -v setsid >/dev/null 2>&1; then
    exec setsid "$self" "$@"
  elif command -v perl >/dev/null 2>&1; then
    exec perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$self" "$@"
  else
    exec "$self" "$@"
  fi
}

log "variant hold=$hold after=$after decision=$decision trap=$trapmode"
watched="recorder=$$"
if [ "$after" -gt 0 ]; then
  deadline=$(($(date +%s) + hold + after))
  "$self" --child "$sig" "$deadline" child </dev/null >/dev/null 2>&1 &
  watched="$watched child=$!"
  in_own_session --child "$sig" "$deadline" outsider </dev/null >/dev/null 2>&1 &
  watched="$watched outsider=$!"
fi
# Let go of at once, through a subshell that exits, so the watcher is no
# descendant of the hook's by the time an agent ends the hook's tree.
# shellcheck disable=SC2086 # one word a watched process
(in_own_session --watch "$sig" "$((hold + after + 120))" $watched </dev/null >/dev/null 2>&1 &)

hold_until "$(($(date +%s) + hold))"

case $decision:$agent in
  allow:copilot) answer='{"behavior":"allow"}' ;;
  deny:copilot) answer="{\"behavior\":\"deny\",\"message\":\"$message\"}" ;;
  allow:*) answer='{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}' ;;
  deny:*) answer="{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"deny\",\"message\":\"$message\"}}}" ;;
  *) answer= ;;
esac
if [ -z "$answer" ]; then
  log printed-nothing
elif printf '%s\n' "$answer"; then
  log "printed-$decision"
else
  log "could-not-print-$decision"
fi
exit 0
RECORDER
} >"$record"
chmod +x "$record"

hook() {
  printf "'%s' %s %s" "$record" "$agent" "$1"
}

# One matcher group an event, with no matcher so every tool is recorded, in
# the shape Claude Code and Codex both read.
settings_hooks() {
  first=yes
  for event in "$@"; do
    [ -n "$first" ] || printf ',\n'
    first=
    extra=
    case $event in
      PermissionRequest) [ -z "$timeout" ] || extra=", \"timeout\": $timeout" ;;
    esac
    printf '    "%s": [{ "hooks": [{ "type": "command", "command": "%s"%s }' "$event" "$(hook "$event")" "$extra"
    if [ "$event" = PermissionRequest ] && [ -n "$second" ]; then
      printf ', { "type": "command", "command": "%s"%s }' "$(hook PermissionRequest-2)" "$extra"
    fi
    printf '] }]'
  done
  printf '\n'
}

case $agent in
  claude)
    mkdir -p "$root/.claude"
    # The ask rule is C7's: a command that matches it asks whatever a hook says.
    {
      echo '{'
      echo '  "permissions": { "ask": ["Bash(touch probe-ask*)"] },'
      echo '  "hooks": {'
      settings_hooks PermissionRequest PermissionDenied PreToolUse PostToolUse PostToolUseFailure \
        Notification UserPromptSubmit Stop StopFailure SubagentStart SubagentStop SessionStart SessionEnd
      echo '  }'
      echo '}'
    } >"$root/.claude/settings.json"
    # One MCP tool to ask permission for, as C13 needs: a stdio server with a
    # single `echo` tool, in Python because that is on every machine this
    # runs on and an MCP server needs nothing more than JSON lines.
    cat >"$root/.probe/mcp.py" <<'MCP'
import json, sys
for line in sys.stdin:
    request = json.loads(line)
    method, ident = request.get("method"), request.get("id")
    if ident is None:
        continue
    if method == "initialize":
        result = {"protocolVersion": request["params"]["protocolVersion"],
                  "capabilities": {"tools": {}}, "serverInfo": {"name": "probe", "version": "1"}}
    elif method == "tools/list":
        result = {"tools": [{"name": "echo", "description": "Echo the text back.",
                             "inputSchema": {"type": "object", "properties": {"text": {"type": "string"}},
                                             "required": ["text"]}}]}
    elif method == "tools/call":
        text = request["params"].get("arguments", {}).get("text", "")
        result = {"content": [{"type": "text", "text": text}]}
    else:
        result = {}
    print(json.dumps({"jsonrpc": "2.0", "id": ident, "result": result}), flush=True)
MCP
    printf '{ "mcpServers": { "probe": { "command": "python3", "args": ["%s"] } } }\n' \
      "$root/.probe/mcp.py" >"$root/.probe/mcp.json"
    # Handed over on the command line and kept out of the project's own
    # .mcp.json, which Claude Code would first ask to approve.
    start="cd $root && claude --model haiku --setting-sources project,local --mcp-config .probe/mcp.json --strict-mcp-config"
    headless="cd $root && claude -p --model haiku --setting-sources project,local 'Run touch probe-print with the Bash tool.'"
    cat <<EOF
Claude Code, from a Crook pane:
  $start
Headless, for C1:
  $headless
--setting-sources leaves your own settings out, so only the probe's hooks run.
EOF
    ;;
  codex)
    # A CODEX_HOME of the project's own, for the hooks and for everything
    # trusting them writes: Codex 0.149.1 keeps a trusted directory's
    # trust_level and each trusted hook's trusted_hash in CODEX_HOME's
    # config.toml, which would otherwise be ~/.codex's. It starts empty
    # rather than copied, so no login of the person's is copied with it.
    home=$root/.probe/codex-home
    mkdir -p "$home"
    {
      echo '{'
      echo '  "hooks": {'
      settings_hooks PermissionRequest PreToolUse PostToolUse UserPromptSubmit Stop SessionEnd
      echo '  }'
      echo '}'
    } >"$home/hooks.json"
    cat <<EOF
Codex CLI, from a Crook pane, with a CODEX_HOME of the probe's own:
  cd $root && CODEX_HOME=$home codex
That home has no login yet. Log in to it first, which --clean removes with it:
  CODEX_HOME=$home codex login
It holds the hooks for review on start: trust them there or in /hooks.
EOF
    ;;
  copilot)
    mkdir -p "$root/.github/hooks"
    # Both spellings of the permission hook, since P1 is which one fires.
    {
      echo '{'
      echo '  "version": 1,'
      echo '  "hooks": {'
      first=yes
      for event in permissionRequest PermissionRequest preToolUse postToolUse userPromptSubmitted \
        notification agentStop sessionStart sessionEnd; do
        [ -n "$first" ] || printf ',\n'
        first=
        extra=
        case $event in
          permissionRequest | PermissionRequest) [ -z "$timeout" ] || extra=", \"timeoutSec\": $timeout" ;;
        esac
        printf '    "%s": [{ "type": "command", "bash": "%s"%s }]' "$event" "$(hook "$event")" "$extra"
      done
      printf '\n  }\n}\n'
    } >"$root/.github/hooks/probe.json"
    cat <<EOF
GitHub Copilot CLI, from a Crook pane:
  cd $root && copilot
EOF
    ;;
  opencode)
    mkdir -p "$root/.opencode/plugins"
    {
      echo "// Installed by crook's script/probe-permission-hooks; removed by its --clean."
      echo "const root = \"$root\""
      echo "const dir = process.env.PROBE_DIR ?? \"$evidence\""
      cat <<'PLUGIN'
import { appendFileSync, existsSync, mkdirSync, readFileSync } from "node:fs"

// The variant, the environment's overridden by the `variant` command's file.
const variant = () => {
  const values = { ...process.env }
  const file = `${root}/.probe/variant`
  if (existsSync(file))
    for (const line of readFileSync(file, "utf8").split("\n")) {
      const at = line.indexOf("=")
      if (at > 0) values[line.slice(0, at)] = line.slice(at + 1)
    }
  return { hold: Number(values.PROBE_HOLD ?? 0) || 0, decision: values.PROBE_DECISION ?? "none" }
}

export const ProbePlugin = async ({ client }) => {
  mkdirSync(dir, { recursive: true })
  const write = (name, value) =>
    appendFileSync(`${dir}/${(Date.now() / 1000).toFixed(3)}-${process.pid}-${name}.json`, JSON.stringify(value) + "\n")
  return {
    event: async ({ event }) => {
      if (!event.type.startsWith("permission.") && !event.type.startsWith("question.")) return
      write(event.type, event.properties)
      if (event.type !== "permission.asked") return
      const { hold, decision } = variant()
      if (decision !== "allow" && decision !== "deny") return
      // The SDK name the plan read; O2 is whether a reply through it closes
      // the TUI's own prompt, and O3 what a late one returns.
      setTimeout(async () => {
        const response = decision === "allow" ? "once" : "reject"
        try {
          const result = await client.postSessionIdPermissionsPermissionId({
            path: { id: event.properties.sessionID, permissionID: event.properties.id },
            body: { response },
          })
          write("reply", { response, data: result?.data ?? null, error: result?.error ?? null })
        } catch (error) {
          write("reply", { response, thrown: String(error) })
        }
      }, hold * 1000)
    },
  }
}
PLUGIN
    } >"$root/.opencode/plugins/record.ts"
    cat <<EOF
OpenCode, from a Crook pane:
  cd $root && opencode
EOF
    ;;
esac

cat <<EOF
Evidence: $evidence
Between cases:  script/probe-permission-hooks $agent variant HOLD=60 DECISION=none
What happened:  script/probe-permission-hooks $agent timeline
When done:      script/probe-permission-hooks $agent --clean
EOF
