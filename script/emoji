#!/usr/bin/env python3
"""Regenerate `app/src/tab/emoji_data.rs`: every emoji a tab can be given, and
the words that find it.

    ./script/emoji

Downloads Unicode's pinned `emoji-test.txt` — the list, in Unicode's own order
and with an English name each — and CLDR's annotations for English and Russian
from the npm registry, and writes one Rust file. A generator for the reason
`script/icons` is one: the table never changes at runtime, so nothing in the
binary should parse it.

What is left out: the skin-tone variants. Each is the same picture five more
times over, and a person who wants one can paste it; the grid is for finding
an emoji, not for a sixth copy of every hand.
"""

import io
import json
import tarfile
import urllib.request
from pathlib import Path

# Pinned, so the same checkout regenerates the same file. 15.1 rather than the
# newest: an emoji the system's font has never heard of is a box in the grid,
# and 15.1 is what the fonts shipping today all draw.
EMOJI_VERSION = "15.1"
CLDR_VERSION = "49.0.0"

EMOJI_TEST = f"https://unicode.org/Public/emoji/{EMOJI_VERSION}/emoji-test.txt"
CLDR = "https://registry.npmjs.org/cldr-annotations{kind}-full/-/cldr-annotations{kind}-full-{version}.tgz"

# The search languages: the interface's own, and the one its owner types in.
LANGUAGES = ["en", "ru"]

OUTPUT = Path(__file__).resolve().parent.parent / "app/src/tab/emoji_data.rs"

# What `TabEmoji` holds, in bytes. Nothing longer can be given to a tab, so
# nothing longer is offered.
CAPACITY = 32


def fetch(url):
    with urllib.request.urlopen(url) as response:
        return response.read()


def annotations(kind, language):
    """CLDR's words for every emoji in one language, keyed without FE0F."""
    archive = tarfile.open(
        fileobj=io.BytesIO(fetch(CLDR.format(kind="-derived" if kind else "", version=CLDR_VERSION)))
    )
    folder = "annotationsDerived" if kind else "annotations"
    member = archive.extractfile(f"package/{folder}/{language}/annotations.json")
    data = json.load(member)[folder]["annotations"]
    return {key.replace("️", ""): value for key, value in data.items()}


def entries():
    """Every fully-qualified emoji without a skin tone: (emoji, English name)."""
    for line in fetch(EMOJI_TEST).decode("utf-8").splitlines():
        if not line or line.startswith("#"):
            continue
        codes, rest = line.split(";", 1)
        if not rest.strip().startswith("fully-qualified"):
            continue
        # `# 🦊 E3.0 fox`: the emoji, the version it arrived in, its name.
        name = rest.split("#", 1)[1].strip().split(" ", 2)[2]
        if "skin tone" in name:
            continue
        emoji = "".join(chr(int(code, 16)) for code in codes.split())
        if len(emoji.encode("utf-8")) > CAPACITY:
            continue
        yield emoji, name


def rust_string(text):
    out = []
    for character in text:
        if character in '"\\':
            out.append("\\" + character)
        # Letters are written as themselves, so the Russian reads as Russian;
        # anything else outside ASCII — the emoji, and the joiners and
        # selectors inside them, which are invisible — is escaped.
        elif character.isalpha() and ord(character) < 0x2000:
            out.append(character)
        elif ord(character) < 0x20 or ord(character) > 0x7E:
            out.append(f"\\u{{{ord(character):x}}}")
        else:
            out.append(character)
    return '"' + "".join(out) + '"'


def main():
    words = {
        language: {**annotations(True, language), **annotations(False, language)}
        for language in LANGUAGES
    }

    lines = [
        "//! Every emoji a tab can be given, and the words that find it.",
        "//!",
        f"//! Generated by `script/emoji` from Unicode's emoji-test.txt {EMOJI_VERSION} and",
        f"//! CLDR {CLDR_VERSION}'s annotations in {', '.join(LANGUAGES)}. Do not edit: change the",
        "//! script and run it.",
        "",
        "/// `(emoji, name, words)` in Unicode's order, which is grouped: faces, then",
        "/// people, animals, food, travel, activities, objects, symbols, flags.",
        "/// `words` is lower case, every name and keyword in every language, joined",
        "/// by spaces — what a search is matched against.",
        "#[rustfmt::skip]",
        "pub(crate) static EMOJI: &[(&str, &str, &str)] = &[",
    ]
    count = 0
    for emoji, name in entries():
        key = emoji.replace("️", "")
        found = [name]
        for language in LANGUAGES:
            entry = words[language].get(key, {})
            found += entry.get("tts", []) + entry.get("default", [])
        seen = []
        for word in " ".join(found).lower().replace("|", " ").split():
            word = word.strip(":,")
            if word and word not in seen:
                seen.append(word)
        lines.append(
            f"    ({rust_string(emoji)}, {rust_string(name)}, {rust_string(' '.join(seen))}),"
        )
        count += 1
    lines += ["];", ""]
    OUTPUT.write_text("\n".join(lines), encoding="utf-8")
    print(f"wrote {count} emoji to {OUTPUT}")


if __name__ == "__main__":
    main()
