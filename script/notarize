#!/bin/sh
#
# Send a signed artifact to Apple, wait for the answer, and staple the ticket.
#
#   ./script/notarize dist/macos/Crook.app
#   ./script/notarize dist/macos/crook-v0.1.0-macos.dmg
#
# Notarization is what removes the dialog. A Developer ID signature alone still
# gets "Apple could not verify…" on a downloaded copy; the signature says who
# built it, and notarization is Apple saying it scanned that exact build. What
# is stapled afterwards is a ticket, so the check works with no network.
#
# Credentials come from the environment, an App Store Connect API key by
# preference — it belongs to a team rather than to a person and does not break
# when somebody turns on two-factor:
#
#   APPLE_API_KEY_ID     the key's ID
#   APPLE_API_ISSUER_ID  the issuer UUID at the top of the Keys page
#   APPLE_API_KEY_PATH   the AuthKey_XXXX.p8 file, which Apple lets you
#                        download exactly once
#
# or, failing that, an Apple ID and an app-specific password:
#
#   APPLE_ID  APPLE_APP_PASSWORD  APPLE_TEAM_ID
#
# An .app cannot be submitted as a directory, so one is zipped first with
# `ditto`, which is the only zip on a Mac that preserves a bundle's symlinks
# and extended attributes. The ticket is stapled to the .app itself, never to
# the zip, which is thrown away.

set -eu

cd "$(dirname "$0")/.."

ARTIFACT="${1:-}"

if [ -z "$ARTIFACT" ] || [ "$ARTIFACT" = -h ] || [ "$ARTIFACT" = --help ]; then
  cat <<'EOF'
Usage: ./script/notarize <path to .app or .dmg>

Needs either APPLE_API_KEY_ID + APPLE_API_ISSUER_ID + APPLE_API_KEY_PATH,
or APPLE_ID + APPLE_APP_PASSWORD + APPLE_TEAM_ID.
EOF
  [ -n "$ARTIFACT" ] && exit 0
  exit 1
fi

[ -e "$ARTIFACT" ] || { echo "error: nothing at $ARTIFACT" >&2; exit 1; }
[ "$(uname -s)" = Darwin ] || { echo "error: this needs macOS: xcrun notarytool" >&2; exit 1; }

# Built once and reused by both calls below, so that the credential rules live
# in one place rather than in each.
if [ -n "${APPLE_API_KEY_ID:-}" ] && [ -n "${APPLE_API_ISSUER_ID:-}" ] && [ -n "${APPLE_API_KEY_PATH:-}" ]; then
  [ -f "$APPLE_API_KEY_PATH" ] || { echo "error: no key file at $APPLE_API_KEY_PATH" >&2; exit 1; }
  set -- --key "$APPLE_API_KEY_PATH" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER_ID"
elif [ -n "${APPLE_ID:-}" ] && [ -n "${APPLE_APP_PASSWORD:-}" ] && [ -n "${APPLE_TEAM_ID:-}" ]; then
  set -- --apple-id "$APPLE_ID" --password "$APPLE_APP_PASSWORD" --team-id "$APPLE_TEAM_ID"
else
  echo "error: no notarization credentials in the environment." >&2
  echo "       Set APPLE_API_KEY_ID, APPLE_API_ISSUER_ID and APPLE_API_KEY_PATH," >&2
  echo "       or APPLE_ID, APPLE_APP_PASSWORD and APPLE_TEAM_ID." >&2
  exit 1
fi

SUBMISSION="$ARTIFACT"
CLEANUP=""

case "$ARTIFACT" in
  *.app)
    SUBMISSION="$(dirname "$ARTIFACT")/$(basename "$ARTIFACT" .app)-notarize.zip"
    CLEANUP="$SUBMISSION"
    rm -f "$SUBMISSION"
    echo "==> Zipping $ARTIFACT for submission"
    ditto -c -k --keepParent "$ARTIFACT" "$SUBMISSION"
    ;;
esac

# The upload has a watchdog, because notarytool's own has none: on 2026-09-22
# `submit` of the v0.1.8 image printed nothing for an hour and the job died on
# its timeout, with nothing to show for four release builds. A stalled upload
# is a stalled connection, not a verdict, so it is killed and sent once more;
# a second stall is then a real answer about the network today.
UPLOAD_MINUTES=15
UPLOAD_OUTPUT="$(mktemp)"
# Read when the trap fires, not now: both names are settled by then.
# shellcheck disable=SC2016 # single quotes on purpose
trap 'rm -f "$UPLOAD_OUTPUT"; [ -z "$CLEANUP" ] || rm -f "$CLEANUP"' EXIT INT TERM

# Runs one upload with the watchdog beside it. Its output — the plist with
# the submission id, or notarytool's complaint — lands in UPLOAD_OUTPUT; the
# exit status is notarytool's, or the kill's when the watchdog fired.
upload() {
  xcrun notarytool submit "$SUBMISSION" "$@" --output-format plist > "$UPLOAD_OUTPUT" 2>&1 &
  UPLOAD_PID=$!
  # notarytool is xcrun's child, so the child goes first: killing only the
  # parent would leave the upload running and `wait` waiting on it.
  ( sleep $(( UPLOAD_MINUTES * 60 )) && pkill -TERM -P "$UPLOAD_PID" 2>/dev/null; kill "$UPLOAD_PID" 2>/dev/null ) &
  WATCHDOG_PID=$!
  UPLOAD_STATUS=0
  wait "$UPLOAD_PID" || UPLOAD_STATUS=$?
  kill "$WATCHDOG_PID" 2>/dev/null || true
  wait "$WATCHDOG_PID" 2>/dev/null || true
  return "$UPLOAD_STATUS"
}

echo "==> Submitting $(basename "$SUBMISSION")"
# Submitted and then polled by hand rather than with --wait. --wait does the
# same polling, but one request to Apple that times out on the way ends it
# with a non-zero exit — and that happened to a submission Apple had already
# accepted, on a build nothing was wrong with. A poll that fails to reach
# Apple is not an answer from Apple, so here it is asked again.
# 143 is the watchdog's kill and nothing notarytool says by itself; any other
# failure is an answer and is not sent twice.
if ! upload "$@"; then
  if [ "$UPLOAD_STATUS" -eq 143 ]; then
    echo "    the upload did not finish in $UPLOAD_MINUTES minutes; sending it again"
    upload "$@" || true
  fi
  if [ "$UPLOAD_STATUS" -ne 0 ]; then
    echo "error: the submission was not accepted for processing:" >&2
    cat "$UPLOAD_OUTPUT" >&2
    exit 1
  fi
fi
SUBMITTED="$(cat "$UPLOAD_OUTPUT")"
ID="$(printf '%s' "$SUBMITTED" | plutil -extract id raw -o - -)" || ID=""
[ -n "$ID" ] || { echo "error: no submission id in the answer:" >&2; printf '%s\n' "$SUBMITTED" >&2; exit 1; }
echo "    submission $ID"

# Apple usually answers inside a couple of minutes and has no upper bound
# worth relying on; thirty minutes is where this stops believing it will.
echo "==> Waiting on Apple"
DEADLINE=$(( $(date +%s) + 30 * 60 ))
STATUS="In Progress"
while [ "$STATUS" = "In Progress" ]; do
  if [ "$(date +%s)" -ge "$DEADLINE" ]; then
    echo "error: Apple has not answered in thirty minutes; submission $ID" >&2
    exit 1
  fi
  sleep 20
  # A failed poll is a poll, not a verdict: the status stays as it was and
  # the loop asks again.
  INFO="$(xcrun notarytool info "$ID" "$@" --output-format plist)" || {
    echo "    could not reach Apple; asking again"
    continue
  }
  STATUS="$(printf '%s' "$INFO" | plutil -extract status raw -o - -)" || STATUS="In Progress"
  echo "    $STATUS"
done

# A rejection prints a status; the reason for it is only in the log, which is
# why that is fetched rather than left for somebody to find the command for.
if [ "$STATUS" != Accepted ]; then
  echo "error: notarization ended as \"$STATUS\". The submission's log:" >&2
  xcrun notarytool log "$ID" "$@" >&2 || true
  exit 1
fi

echo "==> Stapling the ticket to $ARTIFACT"
xcrun stapler staple "$ARTIFACT"
xcrun stapler validate "$ARTIFACT"

# The last word, and the one that matters: this is the assessment Gatekeeper
# itself makes when somebody double-clicks the thing.
case "$ARTIFACT" in
  *.app) spctl --assess --type execute --verbose=2 "$ARTIFACT" ;;
  *.dmg) spctl --assess --type open --context context:primary-signature --verbose=2 "$ARTIFACT" ;;
esac

echo "==> $ARTIFACT is notarized and stapled"
