#!/bin/sh
#
# Publish the crates somebody outside this repository needs, to crates.io.
#
#   ./script/publish --dry-run    # everything except the upload
#   ./script/publish
#
# There are two. `crook_plugin_api` is the vocabulary a sandboxed plugin is
# written against, and every plugin that exists carries a vendored copy of it
# for want of a published one — which is how a host and a guest come to hold
# two lists of capabilities that disagree. `crook_wasm` is the sandbox, and it
# goes with it for one job: `crook-plugin-info`, the reader a registry
# describes an artifact with, which has to be the host's own or the index and
# the terminal will not agree about what a plugin is.
#
# Not a CI job, and not one by accident: publishing is the one irreversible
# thing in this tree — crates.io yanks a version, it never deletes one — and it
# needs a token no other step here has. A human runs this.

set -eu

cd "$(dirname "$0")/.."

# rustup was installed with --no-modify-path on this machine, so the proxies
# are not on a login shell's PATH.
export PATH="$HOME/.cargo/bin:$PATH"

# In dependency order, which is the order they have to be uploaded in: a crate
# whose dependency is not on crates.io yet does not publish, and `cargo
# publish --dry-run` on the second one fails until the first is up for real.
CRATES="crook_plugin_api crook_wasm"

DRY_RUN=0

# Whether crates.io already has this version.
#
# Asked of the sparse index rather than of the website, because that is the
# file cargo itself resolves against: one line of JSON per version, under a
# path made of the first four characters of the name.
already_published() {
  crate=$1
  version=$2
  index="https://index.crates.io/$(echo "$crate" | cut -c1-2)/$(echo "$crate" | cut -c3-4)/$crate"
  curl --silent --fail "$index" 2>/dev/null | grep -q "\"vers\":\"$version\""
}

usage() {
  cat <<'USAGE'
Usage: ./script/publish [--dry-run]

Publishes crook_plugin_api and crook_wasm to crates.io, in that order,
after running the checks CI runs. --dry-run does everything except the
upload — and cannot check crook_wasm until crook_plugin_api is up, because
packaging rewrites the path dependency to a registry one.
USAGE
}

for argument in "$@"; do
  case "$argument" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $argument" >&2; usage >&2; exit 2 ;;
  esac
done

# The version *is* the ABI — `0.<abi>.<patch>` — and each crate holds a test
# saying so. Running their tests here is a second or two and the last chance to
# catch a version bumped without the constant. It is not the whole of CI: that
# is four commands over the workspace, and what runs here is the two crates
# being uploaded.
cargo fmt --all --check
for crate in $CRATES; do
  cargo clippy --locked -p "$crate" --all-targets -- -D warnings
  cargo test --locked -p "$crate"
done

for crate in $CRATES; do
  version=$(cargo metadata --locked --format-version=1 --no-deps \
    | sed -n "s/.*\"name\":\"$crate\",\"version\":\"\([^\"]*\)\".*/\1/p")

  if [ "$DRY_RUN" = 1 ]; then
    echo "==> $crate $version (dry run)"
    cargo publish --locked --dry-run -p "$crate"
    continue
  fi

  # Skipped if it is already up there, which makes this safe to run again.
  # The likely failure is the *second* crate — it cannot even be packaged
  # until the first is in the registry — and a rerun that died on "crate
  # version already uploaded" would never reach it.
  if already_published "$crate" "$version"; then
    echo "==> $crate $version is already on crates.io"
    continue
  fi

  echo "==> $crate $version"
  cargo publish --locked -p "$crate"
  # A published version is a version a plugin can be pinned to forever, so it
  # is worth a tag pointing at the commit it was built from.
  git tag "$crate-v$version" 2>/dev/null || true
  echo "tagged $crate-v$version; push it with: git push origin $crate-v$version"
done
