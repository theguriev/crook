#!/bin/sh
#
# Cut a release: bump the version, write its changelog, commit, tag.
#
#   ./script/release 0.1.8                  # everything below, leaving the tag unpushed
#   ./script/release 0.1.8 --push           # and push main with the tag, which starts release.yml
#   ./script/release 0.1.8 --dry-run        # print the changelog it would write and stop
#   ./script/release 0.1.8 --allow-untyped  # release over commits the changelog cannot list
#   ./script/release 0.1.8 --no-ci-check    # release a commit Crook CI has not passed
#
# What one release is, in order:
#
#   1. The tree is clean, on main, and the version is newer than the last tag.
#   2. Crook CI passed the commit being released: its newest run on that
#      commit, as gh reports it, completed with success.
#   3. `version` under [workspace.package] in Cargo.toml becomes the new one and
#      Cargo.lock is refreshed, because release.yml refuses a tag whose manifest
#      disagrees with it. The plugin's three manifests under
#      packaging/claude-code take the same version.
#   4. changelogen reads every commit since the previous v* tag and prepends a
#      `## vX.Y.Z` section to CHANGELOG.md, grouped by the types in
#      changelog.config.json. release.yml lifts that section into the release
#      notes through script/release-notes, so the file in the repository and
#      the release page say the same.
#   5. One commit, `chore(release): vX.Y.Z`, and an annotated tag on it.
#
# The generator reads only Conventional Commit titles and drops the rest without
# a word. A release whose range holds such commits is refused here, listing
# them, unless --allow-untyped says the omission is understood — which is the
# case exactly once, for the release that spans the change of convention.
#
# A commit is not one CI passed just by being on main: the local gate runs on
# one machine, and Crook CI may not have run on the merge yet, or may have
# failed on it. v0.1.20 and v0.1.21 were each tagged minutes after a red run,
# because nothing here asked. So step 2 asks GitHub, before a file is touched,
# and refuses a commit whose run is missing, still going or ended any way but
# success, naming the run when there is one. The newest run is the one that
# counts: a rerun that fails after a pass is a flake nobody has explained yet.
# gh is needed for that, logged in; without it the answer is a refusal too,
# not a pass. A --dry-run says what CI said and carries on. --no-ci-check
# skips the question, for the release that cannot wait for CI — one that
# fixes a release already broken in people's hands — and only that.
#
# changelogen is pinned rather than @latest: the notes for v0.1.8 should not
# change shape because a generator release happened in between. Node is the
# only thing it needs; there is no package.json here and there will not be one.
set -eu

CHANGELOGEN="changelogen@0.6.2"
CI_WORKFLOW="Crook CI"
PLUGIN_MANIFESTS="packaging/claude-code/.claude-plugin/plugin.json packaging/claude-code/.codex-plugin/plugin.json packaging/claude-code/.github/plugin/plugin.json"

here=$(cd "$(dirname "$0")/.." && pwd)
cd "$here"

version=${1:-}
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "usage: script/release X.Y.Z [--push] [--dry-run] [--allow-untyped] [--no-ci-check]" >&2; exit 2 ;;
esac
shift
push=; dry=; allow_untyped=; no_ci_check=
for arg in "$@"; do
  case "$arg" in
    --push) push=1 ;;
    --dry-run) dry=1 ;;
    --allow-untyped) allow_untyped=1 ;;
    --no-ci-check) no_ci_check=1 ;;
    *) echo "release: unknown option $arg" >&2; exit 2 ;;
  esac
done
tag="v$version"

fail() { echo "release: $1" >&2; exit 1; }

command -v npx >/dev/null || fail "node is needed to run changelogen — https://nodejs.org"
[ "$(git branch --show-current)" = main ] || fail "release from main, not $(git branch --show-current)"
[ -z "$(git status --porcelain)" ] || fail "the tree is not clean"
git rev-parse -q --verify "refs/tags/$tag" >/dev/null && fail "$tag already exists"

# The previous release is the newest v* tag; the crate tags (crook_wasm-v0.8.0)
# are a different thing and are skipped on purpose, which is also why
# changelogen is never left to pick "the latest tag" by itself.
previous=$(git tag --list 'v[0-9]*' --sort=-v:refname | head -1)
[ -n "$previous" ] || fail "no previous v* tag to write the changelog from"
range="$previous..HEAD"
[ "$(git rev-list --count "$range")" -gt 0 ] || fail "nothing since $previous"

# Newer than the last one, by sort -V, so 0.1.10 goes after 0.1.9.
newest=$(printf '%s\n%s\n' "${previous#v}" "$version" | sort -V | tail -1)
[ "$newest" = "$version" ] && [ "$version" != "${previous#v}" ] \
  || fail "$version is not newer than $previous"

echo "==> $previous → $tag, $(git rev-list --count "$range") commits"

# Prints the Crook CI run that passed commit $1 and succeeds, or prints why
# there is none and fails. The --jq folds a run into `status/conclusion url`;
# the conclusion is empty while the run is going, which leaves `in_progress/`.
#
# There is no `gh auth status` first. It fails when any account gh knows on
# github.com has a dead token, even one gh would not use, and it fails the
# same way when GitHub cannot be reached, so it would send someone who is
# logged in to log in. `gh run list` needs the login anyway, and when it
# cannot answer gh says why on stderr, which is left to reach the terminal:
# gh auth login, a refused token, no network.
ci_verdict() {
  command -v gh >/dev/null \
    || { echo "gh is needed to ask whether $CI_WORKFLOW passed $short — https://cli.github.com"; return 1; }
  run=$(gh run list --workflow "$CI_WORKFLOW" --commit "$1" --limit 1 \
    --json status,conclusion,url --jq '.[] | "\(.status)/\(.conclusion) \(.url)"') \
    || { echo "gh could not ask GitHub about the $CI_WORKFLOW runs on $short, for the reason it gave above"; return 1; }
  state=${run%% *}
  url=${run#* }
  case "$state" in
    "") echo "$CI_WORKFLOW has not run on $short; once main is pushed, start a run with  gh workflow run \"$CI_WORKFLOW\" --ref main  and release when it passes"; return 1 ;;
    completed/success) echo "$CI_WORKFLOW passed $short: $url" ;;
    completed/*) echo "$CI_WORKFLOW did not pass $short, its run ended in ${state#completed/}: $url"; return 1 ;;
    *) echo "$CI_WORKFLOW has not finished with $short, its run is ${state%/}: $url — release when it passes"; return 1 ;;
  esac
}

short=$(git rev-parse --short HEAD)
if [ -n "$no_ci_check" ]; then
  echo "==> --no-ci-check: releasing $short without asking whether $CI_WORKFLOW passed it"
elif verdict=$(ci_verdict "$(git rev-parse HEAD)"); then
  echo "==> $verdict"
elif [ -n "$dry" ]; then
  echo "==> $verdict"
  echo "==> A release would stop there; --dry-run carries on"
else
  fail "$verdict"
fi

if ! ./script/commit-lint "$range"; then
  if [ -n "$allow_untyped" ]; then
    echo "==> --allow-untyped: the titles above will be missing from the notes"
  else
    fail "those would be dropped from the changelog; fix the titles or pass --allow-untyped"
  fi
fi

if [ -n "$dry" ]; then
  echo "==> The changelog section, not written:"
  npx --yes "$CHANGELOGEN" --from "$previous" --to HEAD -r "$version" --no-output
  exit 0
fi

echo "==> Setting Cargo.toml to $version"
# Only the workspace version line: every crate says version.workspace = true.
sed -i.bak "/^\[workspace\.package\]/,/^\[/ s/^version *= *\"[^\"]*\"/version = \"$version\"/" Cargo.toml
rm -f Cargo.toml.bak
grep -q "^version = \"$version\"" Cargo.toml || fail "could not set the version in Cargo.toml"

# The plugin's manifests, one per agent, say the same version: Claude Code
# names the copy it installs by it and updates that copy only when it
# changes, so a release that left them behind would reach nobody who has the
# plugin, and Crook's Agents page compares it with its own to offer Update.
for manifest in $PLUGIN_MANIFESTS; do
  echo "==> Setting $manifest to $version"
  sed -i.bak "s/^  \"version\": *\"[^\"]*\"/  \"version\": \"$version\"/" "$manifest"
  rm -f "$manifest.bak"
  grep -q "^  \"version\": \"$version\"," "$manifest" || fail "could not set the version in $manifest"
done
cargo metadata --format-version 1 >/dev/null

echo "==> Writing CHANGELOG.md"
npx --yes "$CHANGELOGEN" --from "$previous" --to HEAD -r "$version" --output CHANGELOG.md >/dev/null
grep -q "^## $tag" CHANGELOG.md || fail "changelogen wrote no '## $tag' section"

git add Cargo.toml Cargo.lock CHANGELOG.md $PLUGIN_MANIFESTS
git commit -q -m "chore(release): $tag"
git tag -a "$tag" -m "$tag"
echo "==> Committed and tagged $tag"
./script/release-notes "$tag"

if [ -n "$push" ]; then
  echo "==> Pushing main and $tag"
  git push origin main "$tag"
  echo "==> release.yml is building https://github.com/theguriev/crook/releases/tag/$tag"
else
  echo "==> Not pushed. When it looks right:  git push origin main $tag"
fi
